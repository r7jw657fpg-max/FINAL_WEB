{
  "name": "final-web",
  "compatibility_date": "2026-08-01",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karten-db",
      "database_id": "b1f564d2-4e0d-4d2b-baef-1e08e18de470"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "karten-dateien"
    }
  ]
}
